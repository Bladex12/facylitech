# Backend
DATABASE_URL=postgresql+asyncpg://facylitech:facylitech@localhost:5432/facylitech
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173

# Autenticación (docs/contrato-auth.md)
# Secreto de firma de los JWT. En ENVIRONMENT=development se usa uno inseguro por defecto
# (con warning); en cualquier otro entorno es OBLIGATORIO y de al menos 32 caracteres,
# o el backend no arranca. Generar uno: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Duración del token (sin refresh): el técnico trabaja en terreno sin señal
JWT_TTL_OPERADOR_HORAS=12
JWT_TTL_TECNICO_HORAS=24
# Contraseña que asigna seed.py a TODOS los usuarios de demostración (solo demo)
SEED_PASSWORD=facylitech2026

# Despacho en cascada de emergencias: minutos para aceptar antes de pasar al siguiente técnico
TIEMPO_RESPUESTA_EMERGENCIA_MIN=5

# Fotos de evidencia: "local" (disco en backend/media, servido en /media) o "supabase"
STORAGE_BACKEND=local
# MEDIA_DIR=/ruta/absoluta/a/media   # opcional, default backend/media
# Solo con STORAGE_BACKEND=supabase (el bucket debe ser público para mostrar las fotos):
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=evidencias

# Docker Postgres
POSTGRES_USER=facylitech
POSTGRES_PASSWORD=facylitech
POSTGRES_DB=facylitech
POSTGRES_PORT=5432
