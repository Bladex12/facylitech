# Variables del despliegue con docker-compose.prod.yml (ver docs/despliegue.md).
# Copiar a .env.prod y completar. .env.prod NO se sube al repositorio.

# Dominio público que apunta al servidor (registro DNS tipo A). Caddy obtiene el
# certificado HTTPS solo. Para probar en una red local, usar la IP del servidor
# o "localhost" (certificado propio: el navegador pedirá aceptarlo).
DOMINIO=localhost

# OBLIGATORIOS. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
POSTGRES_PASSWORD=

POSTGRES_USER=facylitech
POSTGRES_DB=facylitech

# Duración de la sesión (sin refresh): el técnico trabaja en terreno sin señal
JWT_TTL_OPERADOR_HORAS=12
JWT_TTL_TECNICO_HORAS=24

# Minutos que tiene cada técnico para aceptar una emergencia antes de pasar al siguiente
TIEMPO_RESPUESTA_EMERGENCIA_MIN=5

# Fotos de evidencia: "local" (volumen media del servidor) o "supabase"
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=evidencias

# Contraseña de las cuentas que crea seed.py (datos de simulación).
SEED_PASSWORD=facylitech2026

# Puertos publicados (cambiar si 80/443 están ocupados)
PUERTO_HTTP=80
PUERTO_HTTPS=443
